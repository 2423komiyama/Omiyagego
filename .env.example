# ===== 必須 =====
# MySQL/TiDB 接続文字列（例: mysql://user:pass@host:4000/omiyage?ssl={"rejectUnauthorized":true}）
DATABASE_URL=

# セッションCookie署名用シークレット（openssl rand -hex 32 で生成）
JWT_SECRET=

# ===== 認証（Google OAuth） =====
# https://console.cloud.google.com/apis/credentials で「OAuthクライアントID（ウェブ）」を作成。
# 承認済みリダイレクトURIに https://<ドメイン>/api/oauth/callback を登録。
# 未設定の場合、開発環境（NODE_ENV!=production）では「開発ユーザー」で自動ログインする。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Claude API（コレクター機能の写真OCR） =====
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ===== S3互換ストレージ（Cloudflare R2推奨 / コレクター写真アップロード） =====
# R2の場合: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# バケットを公開している場合の公開URL（未設定なら7日間の署名付きURLを返す）
S3_PUBLIC_BASE_URL=

# ===== Google Maps（地図表示 / フロントエンド） =====
VITE_GOOGLE_MAPS_API_KEY=

# ===== Web Push通知（VAPID / npx web-push generate-vapid-keys で生成） =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# ===== 楽天商品検索API（データ投入スクリプト用） =====
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# ===== 任意 =====
# 管理者権限を持つユーザーのopenId（google:xxxxx 形式）
OWNER_OPEN_ID=
